# PostgreSQL image and database settings
POSTGRES_VERSION=17
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=replace-with-a-strong-unique-password
POSTGRES_PORT=5432

# Host port for the frontend
FRONTEND_PORT=8080

# Backend runtime configuration
JPA_DDL_AUTO=update
APP_BOOTSTRAP_ADMIN_USER_ID=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
